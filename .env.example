# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/database_name"

# ============================================
# AWS S3 CONFIGURATION
# ============================================
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="your-bucket-name"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET="your-jwt-secret-key"
JWT_SECRET_TASKITI_APP="your-taskiti-jwt-secret-key"

# ============================================
# SMTP EMAIL CONFIGURATION
# ============================================
HOST_EMAIL="smtp.example.com"
PORT_EMAIL="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Malet <noreply@malet.app>"

# ============================================
# APPLICATION
# ============================================
PORT="4100"
NODE_ENV="development"

# ============================================
# TAURI UPDATER (CI/CD)
# ============================================
UPDATER_API_KEY="generate-a-random-secret-key"
# Base URL pública donde se sirven los releases (se usa en el manifest del updater)
UPDATES_BASE_URL="https://apimalet.breadriuss.com"

# ============================================
# GOOGLE AUTH
# ============================================
GOOGLE_CLIENT_ID="your-google-client-id"
